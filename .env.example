# Local development. On Render, set these in the dashboard instead.
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-text
# Neon connection string (keep ?sslmode=require). Omit to use local SQLite.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# 0 = API open (only while the UI has no login page). Always 1 on Render.
API_REQUIRE_AUTH=0
